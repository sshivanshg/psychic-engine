# Copy this file to `.env` and edit only if you changed the docker-compose credentials.
# (config.py falls back to these exact defaults, so for the standard setup you don't even need a .env.)

DATABASE_URL=postgresql://tradeos:tradeos@localhost:5432/tradeos

# How far back to pull daily candles on ingest (yfinance period string: 1y, 2y, 5y, max ...)
HISTORY_PERIOD=2y

# Where the ticker list lives (defaults to ./holdings.txt at the project root)
# HOLDINGS_FILE=holdings.txt
