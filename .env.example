# Copy this file to `.env` and edit only what you need — the defaults below match the
# standard docker-compose setup, so for local dev you often don't need a .env at all.

DATABASE_URL=postgresql://tradeos:tradeos@localhost:5432/tradeos

# How far back to pull daily candles on ingest (yfinance period: 1y, 2y, 5y, max ...)
HISTORY_PERIOD=2y

# Portfolio file and benchmark index (NIFTY 50) used for beta.
# PORTFOLIO_FILE=holdings.csv
# BENCHMARK=^NSEI

# --- Phase 1: Risk Agent narration (optional) ---
# Without a key, `tradeos-risk` still prints all the numbers — it just skips the Claude read.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4-8       # or claude-sonnet-4-6 / claude-haiku-4-5 (cheaper)
